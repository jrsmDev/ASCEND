{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel --prefix frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --prefix frontend",
  "framework": "vite",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/download",
      "destination": "/#download",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/demo/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/demo/", "destination": "/demo/index.html" },
    { "source": "/site", "destination": "/index.html" },
    { "source": "/site/", "destination": "/index.html" },
    { "source": "/site/(.*)", "destination": "/$1" },
    { "source": "/website", "destination": "/index.html" },
    { "source": "/website/", "destination": "/index.html" },
    { "source": "/website/(.*)", "destination": "/$1" }
  ]
}
