{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)ASCEND-1.0.0.apk",
      "destination": "https://github.com/jrsmDev/ASCEND/releases/download/apk-v1.0.0/ASCEND.apk",
      "permanent": false
    },
    {
      "source": "/(.*)ASCEND.apk",
      "destination": "https://github.com/jrsmDev/ASCEND/releases/download/apk-v1.0.0/ASCEND.apk",
      "permanent": false
    },
    {
      "source": "/(.*)ASCEND-1.0.0.apk.sha256",
      "destination": "https://github.com/jrsmDev/ASCEND/releases/download/apk-v1.0.0/ASCEND.apk.sha256",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/#download",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/demo/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/demo/exercise-media/(.*)", "destination": "/exercise-media/$1" },
    { "source": "/demo/", "destination": "/demo/index.html" },
    { "source": "/site", "destination": "/index.html" },
    { "source": "/site/", "destination": "/index.html" },
    { "source": "/site/(.*)", "destination": "/$1" },
    { "source": "/website", "destination": "/index.html" },
    { "source": "/website/", "destination": "/index.html" },
    { "source": "/website/(.*)", "destination": "/$1" }
  ]
}
